{
  "name": "academic-personal-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "cms:server": "node scripts/cms/local.mjs",
    "cms:local": "node scripts/cms/start.mjs",
    "build": "astro build",
    "build:site": "node ./scripts/build-mode.mjs site",
    "build:maintenance": "node ./scripts/build-mode.mjs maintenance",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "validate": "node ./scripts/validate.mjs",
    "publications:sync": "node scripts/publications/sync.mjs",
    "publications:migrate": "node scripts/publications/migrate.mjs",
    "publications:report": "node scripts/publications/report.mjs",
    "publications:test": "node --test Validation/publications.test.mjs Validation/oauth.test.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.1",
    "cheerio": "^1.2.0",
    "lenis": "^1.3.26",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.20.1",
    "decap-server": "^3.10.0",
    "typescript": "^6.0.3"
  }
