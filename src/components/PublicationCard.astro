---
import type { CollectionEntry } from 'astro:content';

interface Props {
  publication: CollectionEntry<'publications'>;
  compact?: boolean;
}

const { publication, compact = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (src?: string) => src && src.startsWith('/') ? `${base}${src}` : src;
const titleHref = publication.data.links?.doi || publication.data.links?.paper;
const domainTags = publication.data.domains;
const methodTags = publication.data.methods;
const searchable = [
  publication.data.title,
  publication.data.authors.join(' '),
  publication.data.venue,
  publication.data.year,
  ...domainTags,
  ...methodTags,
].join(' ').toLowerCase();
---

<article
  class:list={[
    compact
      ? 'publication-card interactive-card flex h-full flex-col gap-3 rounded-[24px] p-3'
      : 'publication-card interactive-card grid gap-5 rounded-[28px] p-3 md:grid-cols-[230px_1fr] md:items-center md:p-4',
  ]}
  data-pub-card
  data-review={publication.data.confirmation.pending ? 'pending' : 'confirmed'}
  data-year={publication.data.year}
  data-domain={domainTags.join('|')}
  data-method={methodTags.join('|')}
  data-tags={[...domainTags, ...methodTags].join('|')}
  data-search={searchable}
>
  <div class:list={[
    'publication-card__media flex w-full items-center justify-center overflow-hidden rounded-[20px]',
    compact ? 'aspect-[4/3]' : 'aspect-[4/3] md:min-h-40',
  ]}>
    {publication.data.image ? <div class="publication-card__image-panel">
      <img
        src={withBase(publication.data.image.src)}
        alt={publication.data.image.alt}
        loading="lazy"
        class="size-full object-contain"
      />
    </div> : <span class="publication-image-placeholder" aria-label="Graphical abstract not yet available">Graphical abstract<br />coming soon</span>}
  </div>
  <div class="flex min-w-0 flex-1 flex-col">
    <div class="mb-3 flex flex-wrap gap-2 text-xs font-bold">
      {!compact && publication.data.confirmation.pending && <span class="publication-review-badge" data-review-badge>Information Check Needed</span>}
      {domainTags.map((tag) => <span class="publication-tag publication-tag--domain">{tag}</span>)}
      {methodTags.map((tag) => <span class="publication-tag publication-tag--method">{tag}</span>)}
    </div>
    <h3 class:list={[compact ? 'text-base' : 'text-xl', 'font-bold leading-snug text-ink']}>
      {
        titleHref ? (
          <a class="publication-title-link" href={titleHref} target="_blank" rel="noreferrer">
            {publication.data.title}
          </a>
        ) : (
          publication.data.title
        )
      }
    </h3>
    {!compact && (
      <p class="mt-2 text-sm leading-6 text-muted" aria-label="Authors">
        {publication.data.authorDetails.map((author, index) => (
          <>
            {index > 0 && ', '}
            <span class:list={['publication-author', author.isSelf && 'publication-author--primary']}>
              {author.name}{author.coFirst && <sup title="Equal contribution / co-first author">†</sup>}{author.corresponding && <sup title="Corresponding author">*</sup>}
            </span>
          </>
        ))}
      </p>
    )}
    <p class:list={[compact ? 'publication-venue publication-venue--compact' : 'publication-venue', 'mt-2 font-bold leading-6 text-ink']}>
      {compact ? publication.data.venue : `${publication.data.venue} | ${publication.data.year}`}
    </p>
    {!compact && publication.data.authorDetails.some((author) => author.coFirst) && <p class="mt-1 text-xs text-muted">† Equal contribution</p>}
    {!compact && publication.data.authorDetails.some((author) => author.corresponding) && <p class="mt-1 text-xs text-muted">* Corresponding author</p>}
  </div>
</article>

<style>
.publication-review-badge { display: inline-flex; flex-wrap: wrap; gap: .25rem; align-items: center; padding: .3rem .65rem; border: 1px solid #b7791f; border-radius: 999px; background: #fff4d6; color: #754600; font-size: .7rem; line-height: 1.5; }
.publication-review-badge:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
:global([data-theme="dark"]) .publication-review-badge { background: #382a13; color: #ffda8b; border-color: #967337; }
.publication-image-placeholder { display: grid; place-content: center; min-height: 10rem; text-align: center; color: var(--color-muted, #718096); font-size: 0.8rem; line-height: 1.6; }
sup { margin-left: 0.1em; }
</style>
